{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.5.7",
  "description": "__MSG_extDescription__",
  "default_locale": "zh_TW",
  "permissions": [
    "storage",
    "tts",
    "fontSettings",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["popup.css"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dictionary.json", "fonts/HanaMinB.ttf", "icon16.png", "icon_favicon.svg"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_icon": {
      "16": "icon_action.png",
      "48": "icon_action.png",
      "128": "icon_action.png"
    },
    "default_title": "__MSG_extActionTitle__"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "options_page": "options.html",
  "commands": {
    "inspect-ruby": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "__MSG_cmdInspectRuby__"
    }
  }
}
