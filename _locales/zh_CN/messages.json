{
  "clDesc": {
    "message": "本次更新带来了以下优化：",
    "description": "Changelog description"
  },
  "clItem10": {
    "message": "<b>右键菜单收藏</b>：选中任意中文文字，右键即可快速加入生词本，无需打开悬浮窗。"
  },
  "clItem11": {
    "message": "<b>全新生词本与 AI 助手</b>：支持词汇收藏、拼音检索与多格式导出，并内置 AI 悬浮助手深度解析词义与例句。"
  },
  "clItem12": {
    "message": "<b>粤语学习导航（Learning Hub）</b>：精选收录 33 个权威拼音教学、辞书、输入法与影视资源，全方位助力粤语学习。"
  },
  "clItem13": {
    "message": "<b>粤语本地词典口语释义翻译</b>：词典中 [粤] 口语标签释义支持一键点击或自动翻译（支持 Bing / Google / 自定义 AI）。"
  },
  "clItem5": {
    "message": "🎨 <b>新增注音背景样式</b>：Ruby 内嵌注音模式现已支持“实色背景”与“消散背景”，在任何网页背景下都能保证音标清晰可见。",
    "description": "Changelog item 5"
  },
  "clItem6": {
    "message": "🐛 <b>修复悬浮窗样式问题</b>：修复了在部分网页上悬浮窗排版错乱及遮罩高度不准确的问题。",
    "description": "Changelog item 6"
  },
  "clItem7": {
    "message": "✨ <b>全新「段落翻译」功能</b>：按住指定快捷键（默认 Shift ⇧）鼠标悬停于段落上，即可呼出 AI 提供精准的粤语翻译！"
  },
  "clItem8": {
    "message": "<b>全新“生词本”功能</b>：悬浮窗新增 ⭐ 收藏按钮，或按 <kbd>S</kbd> 键即可快速收藏当前查询的粤语词汇到本地生词本。"
  },
  "clItem9": {
    "message": "<b>生词本管理页面</b>：支持搜索、排序、批量管理，并提供 JSON / CSV / Markdown / TXT 四种格式导出，亦可导入备份。"
  },
