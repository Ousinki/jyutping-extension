{
  "clDesc": {
    "message": "This update brings the following improvements:",
    "description": "Changelog description"
  },
  "clItem10": {
    "message": "<b>Context Menu Collection</b>: Right-click any selected text to instantly add it to your wordbook."
  },
  "clItem11": {
    "message": "<b>New Wordbook & AI Assistant</b>: Save vocabulary, search by Jyutping, export in multiple formats, and ask the built-in AI assistant for contextual explanations."
  },
  "clItem12": {
    "message": "<b>Cantonese Learning Roadmap & Hub</b>: Curated 33 authoritative phonetics tutorials, dictionaries, input methods, and media resources to supercharge your Cantonese learning."
  },
  "clItem13": {
    "message": "<b>Cantonese Colloquial Definition Translation</b>: Click-to-translate or auto-translate [粵] colloquial definitions (supports Bing, Google, or Custom AI)."
  },
  "clItem5": {
    "message": "🎨 <b>New Ruby Background Styles</b>: Ruby annotation mode now supports 'Solid' and 'Fade' background options, ensuring clear readability on any webpage background.",
    "description": "Changelog item 5"
  },
  "clItem6": {
    "message": "🐛 <b>Fixed Floating Popup Styles</b>: Fixed layout distortion and inaccurate mask height issues for the floating popup on certain webpages.",
    "description": "Changelog item 6"
  },
  "clItem7": {
    "message": "✨ <b>New Paragraph Translation</b>: Hold the shortcut key (default Shift ⇧) and hover over a paragraph to trigger AI for accurate Cantonese translation!"
  },
  "clItem8": {
    "message": "<b>New \"Wordbook\" Feature</b>: Added a ⭐ save button to the hover popup. You can also press <kbd>S</kbd> to quickly save the current Cantonese vocabulary to your local wordbook."
  },
  "clItem9": {
    "message": "<b>Wordbook Management</b>: Supports searching, sorting, and batch management. Provides 4 export formats (JSON, CSV, Markdown, TXT) and supports importing backups."
  },
